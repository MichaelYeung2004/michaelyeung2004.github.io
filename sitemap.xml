---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/publications' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/blogs' | absolute_url | xml_escape }}</loc></url>
  {% for post in site.blogs %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% for publication in site.publications %}
  <url><loc>{{ publication.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
</urlset>
